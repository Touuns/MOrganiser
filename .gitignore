# Règle de rédaction : une règle de DOSSIER est ancrée à la racine (« /nom/ ») ou à un
# chemin précis, pour ne jamais masquer un dossier de code source du même nom
# (ex. src-tauri/src/data/). Les règles par EXTENSION restent globales.

# Secrets, variables privées
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
*secret*.json
*secret*.txt
/secrets/

# Bases et données personnelles (y compris journaux SQLite), où qu'elles soient
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.bak
*.backup
*.zip.enc

# Dossiers de données personnelles éventuellement posés à la racine du dépôt
# (les vraies données vivent dans %LOCALAPPDATA%, hors du dépôt)
/data/
/userdata/
/user-data/
/private/
/backups/
/sauvegardes/
/documents-personnels/

# Dépendances et fichiers générés
node_modules/
/dist/
/build/
/release/
/coverage/
/src-tauri/target/
/src-tauri/gen/
*.log

# Installeurs et exécutables (ne jamais versionner de binaires)
*.exe
*.msi

# Environnements locaux et fichiers éditeur
.venv/
__pycache__/
.vs/
.DS_Store
Thumbs.db
.vscode/*.local.json
